#!/bin/bash
# Universal clipboard shortcuts, ported from Omarchy.
#
# Hyprland injects an explicit chord into whatever surface has focus, so
# SUPER+C/V/X mean copy/paste/cut everywhere. Terminals, where Ctrl+C/Ctrl+V
# are already taken, get Ctrl+Insert / Shift+Insert instead.
#
# Sending with explicit mods (rather than a virtual keyboard like wtype) keeps
# the physically held SUPER from merging into the injected chord at the seat.
# The down/up split works around Hyprland's send-key dispatchers sometimes
# leaving synthetic key state stuck or repeating.
# https://github.com/hyprwm/Hyprland/discussions/14099

TERMINAL_CLASSES='^(Alacritty|kitty|com\.mitchellh\.ghostty|foot|org\.codeberg\.dnkl\.foot|org\.wezfurlong\.wezterm)$'

# Hyprland 0.56 added a Lua config format. When one is active, `hyprctl
# dispatch` evaluates Lua instead of the legacy "name args" syntax, so
# sendkeystate has to be written as hl.dsp.send_key_state{...}. Probe once with
# a harmless dispatcher and keep supporting both, so this script survives a
# switch back to hyprland.conf.
if hyprctl dispatch 'hl.dsp.no_op()' 2>/dev/null | grep -q '^ok'; then
  HYPR_LUA_CONFIG=1
else
  HYPR_LUA_CONFIG=0
fi

send_key_state() {
  local mods=$1 key=$2 state=$3

  if ((HYPR_LUA_CONFIG)); then
    hyprctl dispatch "hl.dsp.send_key_state({ mods = '$mods', key = '$key', state = '$state' })" >/dev/null
  else
    hyprctl dispatch sendkeystate "$mods,$key,$state," >/dev/null
  fi
}

send_shortcut_once() {
  local mods=$1 key=$2

  send_key_state "$mods" "$key" down
  sleep 0.05
  send_key_state "$mods" "$key" up
}

active_window_is_terminal() {
  local class
  class=$(hyprctl activewindow | awk -F': ' '/^[[:space:]]*class: /{print $2; exit}')

  [[ $class =~ $TERMINAL_CLASSES ]]
}

case $1 in
  copy)
    if active_window_is_terminal; then
      send_shortcut_once CTRL Insert
    else
      send_shortcut_once CTRL c
    fi
    ;;
  paste)
    if active_window_is_terminal; then
      send_shortcut_once SHIFT Insert
    else
      send_shortcut_once CTRL v
    fi
    ;;
  cut)
    send_shortcut_once CTRL x
    ;;
  *)
    echo "usage: ${0##*/} copy|paste|cut" >&2
    exit 1
    ;;
esac

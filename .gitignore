zsh/.config/zsh/.zcompdump*
*.bak*

# Generated by wallust's theme-apply.sh on every theme switch
hypr/.config/hypr/colors/

# Quickshell runtime state, not configuration:
#   colors.json     written by wallust each theme switch
#   wallpaper-state last wallpaper per theme
quickshell/.config/quickshell/colors.json
quickshell/.config/quickshell/wallpaper-state

# wallust writes terminal colours here; ghostty's config dir is stowed, so the
# generated file would otherwise land in the repo. (kitty's colors/ is local.)
ghostty/.config/ghostty/colors/

# generated by spicetify-wallust-schemes from the wallust palettes
spicetify/.config/spicetify/Themes/wallust/color.ini

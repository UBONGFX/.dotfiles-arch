# Colors come from wallust, regenerated by ~/.config/wallust/theme-apply.sh on
# every theme switch. The `?` makes the include optional, so ghostty still starts
# on a fresh machine before the first theme has been applied -- in that case the
# theme below is the fallback, which is why it is kept rather than deleted.
config-file = ?colors/wallust

# theme = TokyoNight Storm

font-size = 12
font-family = "SF Mono" 

background-opacity = 0.85

mouse-hide-while-typing = true
window-decoration = true

window-padding-x = 12
window-padding-y = 12

# Ghostty has no signal- or IPC-based reload, so a theme switch only reaches
# NEW windows automatically. This re-reads the config in an existing one.
keybind = ctrl+shift+comma=reload_config

# Receiving end of the universal SUPER+C / SUPER+V shortcuts
keybind = control+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
